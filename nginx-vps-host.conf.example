# ==============================================================================
# نمونه فایل تنظیمات Nginx روی خود سرور اصلی (VPS Host) برای دامنه a.rangoresin.com
# اگر روی سیستم‌عامل اوبونتو سرور خود نیز Nginx نصب کرده‌اید که ترافیک پورت 80/443 را
# به پورت 3000 داکر می‌فرستد، این تنظیمات مانع بروز خطای 502 Bad Gateway می‌شود:
# مسیر فایل: /etc/nginx/sites-available/rangoresin.conf
# ==============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name a.rangoresin.com;

    server_tokens off;

    # حجم مجاز آپلود برای فایل‌های بکاپ، اکسل و تصاویر
    client_max_body_size 50M;
    client_body_buffer_size 1M;
    large_client_header_buffers 4 64k;

    # هدرهای امنیتی
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # انتقال ترافیک به کانتینر Nginx/Docker روی پورت 3000 با بافر و تایم‌اوت بالا (ضد خطای 502)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;

        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 8 256k;
        proxy_busy_buffers_size 512k;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_cache_bypass $http_upgrade;
    }
}
