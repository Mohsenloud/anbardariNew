# ==============================================================================
# نمونه فایل تنظیمات Nginx روی سرور اصلی (VPS Host)
# مسیر پیشنهادی: /etc/nginx/sites-available/factor.conf
# پس از کپی، دامنه yourdomain.com را جایگزین کرده و گواهی SSL را با دستور زیر فعال کنید:
#   sudo certbot --nginx -d factor.yourdomain.com
# ==============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name factor.yourdomain.com;

    server_tokens off;

    # حجم مجاز آپلود برای فایل‌های بکاپ، اکسل، ویس و تصاویر
    client_max_body_size 50M;
    client_body_buffer_size 1M;
    large_client_header_buffers 4 64k;

    # هدرهای امنیتی پایه
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)" always;

    # مسدودسازی دسترسی مستقیم به فایل‌های مخفی و سورس‌مپ‌ها
    location ~ /\.(?!well-known) {
        return 404;
    }

    # مسیرهای API و وبهوک تلگرام (بدون کش، بدون بافرینگ تاخیرساز)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Authorization $http_authorization;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }

    # انتقال سایر ترافیک‌ها به کانتینر Nginx/Docker روی پورت 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;

        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 8 256k;
        proxy_busy_buffers_size 512k;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Authorization $http_authorization;
        proxy_cache_bypass $http_upgrade;
    }
}
