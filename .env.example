# ==============================================================================
# VPS & DOCKER PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env before first deployment: cp .env.example .env
# ==============================================================================

# Public URL of your application (used for invoice links & Telegram webhook hints)
APP_URL="https://factor.yourdomain.com"

# ==============================================================================
# PORTS & NETWORK BINDING (DOCKER COMPOSE)
# ==============================================================================
# Main external port exposed by Nginx container (default: 3000)
APP_PORT="3000"
# Secondary HTTP port (default: 8080; set to 80 if no host Nginx is installed)
NGINX_HTTP_PORT="8080"
# Set BIND_IP="127.0.0.1" when using host Nginx + SSL so port 3000/8080 is not exposed directly
BIND_IP="0.0.0.0"

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION (mana_db)
# ==============================================================================
POSTGRES_DB="mana_db"
POSTGRES_USER="mana_user"
# IMPORTANT: Change to a strong random password before first `docker compose up`
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"

# Used only when running Node.js directly outside Docker:
DATABASE_URL="postgresql://mana_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/mana_db"
PORT="3000"
NODE_ENV="production"

# ==============================================================================
# SECURITY & AUTHENTICATION (RECOMMENDED FOR PRODUCTION)
# ==============================================================================
# Secret for HMAC-SHA256 session tokens (generate with: openssl rand -hex 32)
# If left empty, the server auto-generates and persists one in ./data/.session_secret
SESSION_SECRET=""

# Comma-separated list of additional allowed CORS origins (same-origin is always allowed)
ALLOWED_ORIGINS=""

# ==============================================================================
# GEMINI AI & TELEGRAM BOT (OPTIONAL - CAN ALSO BE CONFIGURED IN ADMIN PANEL)
# ==============================================================================
GEMINI_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_URL="https://api.telegram.org"
TELEGRAM_PROXY_URL=""
HTTP_PROXY=""
HTTPS_PROXY=""
